# ──────────────────────────────────────────────────────────
# CogLens — Environment Variables
# ──────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your API keys.
#
#   cp .env.example .env.local
#
# All keys are server-side only (never exposed to the browser).
# ──────────────────────────────────────────────────────────

# ─── AI Provider (at least ONE required) ─────────────────
#
# CogLens uses a primary/fallback strategy:
#   1. Groq (primary)  — fastest inference, recommended
#   2. Gemini (fallback) — used when Groq is unavailable
#
# Get a free Groq key:   https://console.groq.com/keys
# Get a free Gemini key:  https://aistudio.google.com/apikey

GROQ_API_KEY=
GEMINI_API_KEY=

# ─── Search Provider (required) ──────────────────────────
#
# Serper provides Google Search results for source verification.
# Get a free key (2,500 searches): https://serper.dev

SERPER_API_KEY=

# ─── Optional: Supabase (future persistence) ────────────
#
# Not currently used. Reserved for future Supabase integration.
# Create a free project: https://supabase.com

# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# ─── Optional: App URL ──────────────────────────────────
#
# Used for generating share links. Defaults to localhost in dev.

# NEXT_PUBLIC_APP_URL=http://localhost:3000
