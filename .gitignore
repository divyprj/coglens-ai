# ──────────────────────────────────────────────────────────
# CogLens .gitignore
# ──────────────────────────────────────────────────────────

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files
.env
.env.*
!.env.example

# vercel
.vercel

# typescript build
*.tsbuildinfo
next-env.d.ts

# scratch/debug scripts (dev only)
/scratch/

# IDE
.idea/
.vscode/
*.swp
*.swo
